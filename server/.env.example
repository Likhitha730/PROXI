# ProxiSpeak server — environment variables
# Copy this file to `server/.env` and fill in values. Never commit `.env`.
# Every variable has a working local-development default (see src/config/env.js),
# so the server starts with no `.env` at all.

# Port the Express + Socket.IO HTTP server listens on. Default: 8080
PORT=8080

# Interface to bind. Default: 0.0.0.0 (reachable from containers/preview proxies).
HOST=0.0.0.0

# development | production. Default: development
NODE_ENV=development

# Comma-separated list of origins allowed by CORS. Must include the frontend URL.
# Use exactly "*" only for throwaway local experiments.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Verbosity of the JSON logger: error | warn | info | debug. Default: info
LOG_LEVEL=info

# Seconds to wait for in-flight work during SIGINT/SIGTERM shutdown. Default: 10
SHUTDOWN_TIMEOUT_MS=10000

# MongoDB Atlas connection string (mongodb+srv://...). Optional: when empty the
# server logs that persistence is disabled and the health endpoint still reports
# status ok — proximity and movement never depend on the database.
#
# This value is never logged, never returned by an endpoint and never committed.
# Never paste a real credential into this file.
MONGODB_URI=

# Database name used for persistence. Default: proxispeak
MONGODB_DB=proxispeak

# Collection holding one live record per session (see docs/ARCHITECTURE.md §7).
# Default: positions
MONGODB_COLLECTION=positions

# Listening radius for the proximity engine, in world units. Default: 100
PROXIMITY_RADIUS=100

# How often a session's position may be written to MongoDB, in ms.
# Range 250-60000. Default: 2000
POSITION_FLUSH_MS=2000

# ---------------------------------------------------------------------------
# ICE (WebRTC connectivity) — see docs/ARCHITECTURE.md §8
# ---------------------------------------------------------------------------
# STUN servers handed to browsers at GET /api/ice. STUN only discovers a
# browser's public address; it relays no traffic. Comma-separated.
# Default: stun:stun.l.google.com:19302
ICE_STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN relay, for peers behind symmetric NATs, corporate firewalls or
# networks that block UDP. Leave empty to run without a relay: two browsers on
# the same machine or LAN will still connect.
#
#   ICE_TURN_URL      turn:host:3478  |  turns:host:5349
#   ICE_TURN_USERNAME the relay credential's username
#   ICE_TURN_CREDENTIAL the relay credential's password
#
# NEVER COMMIT REAL CREDENTIALS. This file is a template: keep the values in
# `server/.env` (git-ignored) or in your host's secret store. TURN credentials
# are secrets, which is exactly why they are served from /api/ice at runtime
# rather than built into the browser bundle (anything VITE_* is public).
ICE_TURN_URL=
ICE_TURN_USERNAME=
ICE_TURN_CREDENTIAL=
