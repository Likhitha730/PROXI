# ProxiSpeak client — environment variables
# Copy this file to `client/.env` and adjust if needed. Never commit `.env`.
# All variables are optional: every one has a working local-development default
# implemented in `src/config/env.js`.

# Backend Socket.IO URL.
# Default (empty/undefined) = same origin. The Vite dev server proxies
# /socket.io to http://127.0.0.1:8080, and Express serves the built app in
# production, so leaving this empty is correct for both modes.
VITE_SOCKET_URL=

# Backend REST base URL.
# Default (empty/undefined) = same origin, proxied exactly like the socket URL.
# Example for a remote backend: VITE_API_URL=https://api.example.com
VITE_API_URL=

# Product name shown in the header. Default: ProxiSpeak
VITE_APP_NAME=
