# ProxiSpeak client — environment variables
# Copy this file to `client/.env` and adjust if needed. Never commit `.env`.
# All variables are optional: every one has a working local-development default
# implemented in `src/config/env.js`.

# Backend Socket.IO URL.
# Default (empty/undefined) = same origin. The Vite dev server proxies
# /socket.io to http://127.0.0.1:8080, and Express serves the built app in
# production, so leaving this empty is correct for both modes.
VITE_SOCKET_URL=

# Backend REST base URL.
# Default (empty/undefined) = same origin, proxied exactly like the socket URL.
# Example for a remote backend: VITE_API_URL=https://api.example.com
VITE_API_URL=

# Product name shown in the header. Default: ProxiSpeak
VITE_APP_NAME=

# ---------------------------------------------------------------------------
# ICE overrides — DEVELOPMENT ONLY. Normally leave every one of these empty.
# ---------------------------------------------------------------------------
# ICE (STUN/TURN) is configured on the server and fetched at runtime from
# GET /api/ice, which keeps TURN credentials out of this bundle: EVERY VITE_*
# VALUE IS INLINED INTO THE SHIPPED JAVASCRIPT AND IS PUBLIC. Only set these to
# point a local build at a relay you control, and never with a long-lived
# credential. See docs/ARCHITECTURE.md §8.4.
#
# Comma-separated STUN URLs. Empty = use whatever GET /api/ice returns.
VITE_ICE_STUN_URLS=

# Optional TURN relay (turn: or turns: only). Empty = no relay from the client.
VITE_ICE_TURN_URL=
VITE_ICE_TURN_USERNAME=
VITE_ICE_TURN_CREDENTIAL=
